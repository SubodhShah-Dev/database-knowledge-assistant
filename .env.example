# NODE_ENV must be production for any non-local deployment.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://app_user:local_dev_password@localhost:5434/database_knowledge_assistant
# REQUIRED: strong random secret, never a placeholder. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
FRONTEND_ORIGIN=http://localhost:5173
# Optional: point the browser at a separately hosted API. Empty uses the Vite proxy.
VITE_API_URL=

# REQUIRED: 32 bytes, base64 or hex. Encrypts connection secrets and provider keys.
# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=

# Optional: key version for rotation. Defaults to 1. Bump when rotating CONNECTION_ENCRYPTION_KEY.
CONNECTION_ENCRYPTION_KEY_VERSION=1

# REQUIRED in production: recovery passphrase used to wrap a backup of the encryption key.
# Enables recovery of all credentials if CONNECTION_ENCRYPTION_KEY is lost.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up offline, separate from the app database and repository.
CONNECTION_RECOVERY_PASSPHRASE=

# LLM: any OpenAI-compatible provider
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=60000

# Frontend: show demo accounts on login page (dev only)
VITE_SHOW_DEMO_ACCOUNTS=false

# Target-database safety limits
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
SQL_SCHEMA_CACHE_MS=300000
DB_CONNECT_TIMEOUT_MS=5000
MYSQL_CONNECT_TIMEOUT_MS=15000
MYSQL_RECORD_COUNT_TIMEOUT_MS=30000
# Optional comma-separated target hostnames, IPs, or CIDRs. Empty allows any host
# except blocked link-local/cloud metadata addresses.
DB_ALLOWED_HOSTS=
MAX_CONNECTIONS_PER_USER=20
MAX_SELECTED_TABLES=100
