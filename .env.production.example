# Production Environment Variables
# Copy this to your hosting platform's environment variable settings
# NEVER commit this file with real values

# REQUIRED: Set to production for any non-local deployment
NODE_ENV=production
PORT=4000

# REQUIRED: Production PostgreSQL connection string (use Neon, Railway, Render, etc.)
# Format: postgres://user:password@host:port/database?sslmode=require
DATABASE_URL=

# REQUIRED: Strong random secret (32+ chars). Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# REQUIRED: Your production frontend URL (Vercel, Netlify, etc.)
FRONTEND_ORIGIN=https://your-app.vercel.app

# REQUIRED: 32 bytes, base64 or hex. Encrypts connection secrets and provider keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONNECTION_ENCRYPTION_KEY=

# Optional: Key version for rotation. Defaults to 1. Bump when rotating CONNECTION_ENCRYPTION_KEY.
CONNECTION_ENCRYPTION_KEY_VERSION=1

# REQUIRED in production: Recovery passphrase (12+ chars) to wrap backup of encryption key.
# Enables recovery of all credentials if CONNECTION_ENCRYPTION_KEY is lost.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this up OFFLINE, separate from the app database and repository.
CONNECTION_RECOVERY_PASSPHRASE=

# LLM: any OpenAI-compatible provider (Groq, OpenAI, Together, etc.)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=60000

# Target-database safety limits
SQL_MAX_ROWS=100
SQL_TIMEOUT_MS=5000
SQL_SCHEMA_CACHE_MS=300000
DB_CONNECT_TIMEOUT_MS=5000
MYSQL_CONNECT_TIMEOUT_MS=15000
MYSQL_RECORD_COUNT_TIMEOUT_MS=30000
# Optional comma-separated target hostnames, IPs, or CIDRs. Empty allows any host
# except blocked link-local/cloud metadata addresses.
DB_ALLOWED_HOSTS=
MAX_CONNECTIONS_PER_USER=20
MAX_SELECTED_TABLES=100

# Frontend: Disable demo accounts in production
VITE_SHOW_DEMO_ACCOUNTS=false